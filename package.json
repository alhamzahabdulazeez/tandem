{
  "name": "tandem-hooks",
  "version": "0.1.0",
  "description": "A standalone CLI coding agent that verifies at development decision points instead of only at the end.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "tandem": "bin/tandem.cjs",
    "tandem-hooks": "bin/tandem.cjs"
  },
  "main": "src/index.cjs",
  "exports": {
    ".": "./src/index.cjs",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alhamzahabdulazeez/tandem.git"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "commands",
    "templates",
    "bench",
    "docs",
    "VERIFIED.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1"
  },
  "scripts": {
    "test": "node test/run.cjs",
    "test:contracts": "node test/contracts/run.cjs",
    "test:units": "node test/all.cjs",
    "test:live": "node test/live.mjs",
    "preflight": "node bench/preflight.cjs"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "verification",
    "typescript",
    "decision-points"
  ]
}
